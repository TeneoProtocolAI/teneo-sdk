# Teneo SDK Examples - Environment Configuration
# Copy this file to .env and fill in your actual values

# Required: WebSocket URL for Teneo Protocol
WS_URL=wss://your-teneo-server.com/ws

# ──────────────────────────────────────────────────────────────
# Authentication — pick ONE of the two flows below
# ──────────────────────────────────────────────────────────────

# ── Flow A: Private-key auth (challenge-response) ──
# Your Ethereum private key — signs the auth challenge AND x402 payments.
# This is your USER WALLET (the wallet that owns the account).
PRIVATE_KEY=your-private-key-here

# Your user wallet address. Optional — auto-derived from PRIVATE_KEY if omitted.
# This is your USER WALLET (same wallet as PRIVATE_KEY above).
WALLET_ADDRESS=0x...

# ── Flow B: Access-key auth (server-side session key) ──
# Access key bound to a session-key wallet on the backend.
# The backend signs payments server-side using the session key — no x402 signing client-side.
ACCESS_KEY=sk_live_...

# Wallet address used together with ACCESS_KEY.
# IMPORTANT: this must be your SESSION KEY WALLET (the wallet the access key is bound to,
# used for payments), NOT your user wallet. Reuse the WALLET_ADDRESS variable above
# and set it to the session key wallet when running access-key examples.

# ──────────────────────────────────────────────────────────────
# Rooms
# ──────────────────────────────────────────────────────────────

# Optional: Default room to join on connection
DEFAULT_ROOM=general

# Optional: Additional room ID (for multi-room examples)
ROOM_ID=your-room-id-here
